{
  "name": "lyrics-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Synced lyrics on your desktop wallpaper, with a side queue circle",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "powershell -File scripts/build-helper.ps1 && electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "setup": "sh scripts/get-fonts.sh || powershell -ExecutionPolicy Bypass -File scripts/get-fonts.ps1"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "koffi": true
  }
}
